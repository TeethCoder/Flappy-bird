[sub_resource type="GDScript" id="GDScript_v0iea"]
resource_local_to_scene = true
script/source = "extends CharacterBody2D


const JUMP_VELOCITY : float = -300


func _ready() -> void:
	GlobalSignals.player_died.connect(die)


func _physics_process(delta: float) -> void:
	if is_on_floor():
		die()

	rotate_the_player(delta)
	apply_gravity(delta)
	jump()
	move_and_slide()


func apply_gravity(delta : float):
	if not is_on_floor():
		velocity += get_gravity() * delta


func jump():
	if Input.is_action_just_pressed(\"jump\"):
		velocity.y = JUMP_VELOCITY


func die():
	GameManager.reset_game()


func rotate_the_player(delta : float):
	rotation_degrees = clamp(rotation_degrees, -20, 20)
	rotation_degrees += velocity.y * delta
"

